# ==============================================================================
# Cartify Website Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit the actual .env.local file to Git!
# ==============================================================================

# Centralized Cartify REST API Endpoint (Django REST Framework)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Lightweight Infrastructure Health Probe Endpoint
NEXT_PUBLIC_API_HEALTH_URL=http://localhost:8000/api/health/

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

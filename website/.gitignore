# ==============================================================================
# Cartify Website (Next.js) .gitignore
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/cache

# Testing & Coverage
/coverage

# Next.js build output
/.next/
/out/
/build
/dist

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment files (NEVER commit secrets)
.env*.local
.env
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS & Editor files
.DS_Store
.vscode/
.idea/

# ==============================================================================
# Cartify Workspace Environment Configuration Template
# Copy this file to .env (or individual app .env files) and fill in real values.
# NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL!
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend: Django Core Configuration
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_TIME_ZONE=UTC

# ------------------------------------------------------------------------------
# Backend: PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DATABASE_NAME=cartify_db
DATABASE_USER=cartify_user
DATABASE_PASSWORD=replace-with-secure-database-password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=600

# ------------------------------------------------------------------------------
# Backend: Redis & Celery Infrastructure
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# ------------------------------------------------------------------------------
# Backend: Security & CORS Origins (All 3 clients connect here)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Backend: JWT Authentication
# ------------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ------------------------------------------------------------------------------
# Website: Next.js Frontend Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

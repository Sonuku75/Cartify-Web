# ==============================================================================
# Cartify Monorepo Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environments & Secrets (CRITICAL: NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
secrets/

# ------------------------------------------------------------------------------
# Operating System & Editors
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# Python & Django (Backend)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Django media & static collections
/backend/media/
/backend/staticfiles/

# Python test, coverage & packaging
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Celery
celerybeat-schedule
celerybeat.pid

# ------------------------------------------------------------------------------
# Node.js & Next.js (Website)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js build output
.next/
out/
build/
dist/

# Next.js bundle analyzer / telemetry
.next/cache/
.turbo/

# ------------------------------------------------------------------------------
# iOS & Xcode (ios/ - Placeholder)
# ------------------------------------------------------------------------------
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcworkspace/contents.xcworkspacedata
*.xcworkspace/*
!*.xcworkspace/contents.xcworkspacedata
DerivedData/
xcuserdata/
*.xcuserstate
*.xcbkptlist
*.ipa
*.dSYM.zip
*.dSYM

# CocoaPods / Carthage / Swift Package Manager
Pods/
Carthage/Build/
.build/
Packages/

# ------------------------------------------------------------------------------
# Android & Flutter (mobile/ - Placeholder)
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
android/app/build/
android/.gradle/
*.keystore
*.jks

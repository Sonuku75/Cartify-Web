# ==============================================================================
# Cartify Backend Environment Variables Template
# Copy this file to .env and configure for your local/production environment.
# NEVER commit the actual .env file to Git!
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=change-me-in-production-with-a-cryptographically-secure-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_TIME_ZONE=UTC

# PostgreSQL Database Configuration
DATABASE_NAME=cartify_db
DATABASE_USER=cartify_user
DATABASE_PASSWORD=change-me-to-secure-db-password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=600

# Redis & Celery Infrastructure
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# CORS & CSRF (Next.js web client, iOS, and Android)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
